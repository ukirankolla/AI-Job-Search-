# ---------------------------------------------------------------------------
# Noventra — environment variables
# Copy this file to `.env.local` and fill in your values.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project URL and keys: Supabase Dashboard -> Project Settings -> API
# Next.js exposes NEXT_PUBLIC_* variables to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret service-role key. Server-only — NEVER commit it or ship it to the
# browser. Used by API routes/cron that need to bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI (optional) ------------------------------------------------------
# Without a key the app runs in "mock mode": the agents return deterministic
# sample responses and resume embeddings are generated locally, so you can
# develop and demo without paying. Add a key to enable real AI.
OPENAI_API_KEY=

# Optional: override the default models.
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Job discovery (optional) ------------------------------------------------
# Where the app pulls fresh job postings. Only sources whose apply links go
# directly to a company career portal or LinkedIn are used.
# Options:
#   greenhouse -> a company's public Greenhouse board (needs GREENHOUSE_BOARD)
#   lever      -> a company's public Lever board (needs LEVER_COMPANY)
#   workable   -> a company's public Workable board (needs WORKABLE_ACCOUNT)
#   ashby      -> a company's public Ashby board (needs ASHBY_JOB_BOARD)
#   mock       -> deterministic sample postings (default; no keys needed)
JOB_SOURCE=mock
GREENHOUSE_BOARD=
LEVER_COMPANY=
WORKABLE_ACCOUNT=
ASHBY_JOB_BOARD=

# --- Cron / security --------------------------------------------------------
# Any secret string. Sent as the `x-cron-secret` header when invoking
# GET /api/cron/track and GET /api/cron/jobs (e.g. from Vercel Cron).
CRON_SECRET=change-me-to-a-long-random-string

# Comma-separated list of email addresses that bypass all usage limits and
# can grant premium to other users from /upgrade.
ADMIN_EMAILS=you@example.com

# --- App --------------------------------------------------------------------
# Public site origin. Used by server actions when calling internal API
# routes. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
